# ==========================================
# SafarAI Server Environment Configuration
# ==========================================

# Server Port (Render sets this automatically in production)
PORT=5000

# Node Environment
NODE_ENV=production

# MongoDB Connection String (OPTIONAL)
# If omitted or unavailable, SafarAI automatically operates on an in-memory high-speed cache store with zero setup!
MONGODB_URI=mongodb://127.0.0.1:27017/safarai

# CORS Origin (Set to your deployed frontend domain or leave * for all)
CORS_ORIGIN=*
